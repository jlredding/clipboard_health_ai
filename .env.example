# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5   # optional override

# Read-only Snowflake service user (key-pair auth; see README "Setup")
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=APP_READER_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/app_reader_svc_key.p8
SNOWFLAKE_ROLE=CLIPBOARD_READER
SNOWFLAKE_WAREHOUSE=CLIPBOARD_WH
SNOWFLAKE_DATABASE=CLIPBOARD_HEALTH
SNOWFLAKE_SCHEMA=MARTS
